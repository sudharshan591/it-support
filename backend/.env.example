# ── Database ─────────────────────────────────────────────────
# SQLite (default — file stored on the VPS)
DATABASE_URL="file:./prisma/prod.db"

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────────────────────────
# Generate strong secrets: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_64
JWT_REFRESH_SECRET=CHANGE_ME_use_a_different_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── URLs ─────────────────────────────────────────────────────
# Set to your actual domain
FRONTEND_URL=https://yourdomain.com
PORT=4000

# ── Environment ──────────────────────────────────────────────
NODE_ENV=production
